{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/commit-gate.js",
        "matcher": "\\bgit\\b[\\s\\S]*\\bcommit\\b",
        "failClosed": true
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/subagent-model-gate.js",
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/plan-checklist-nudge.js",
        "matcher": "Write|StrReplace|MultiEdit|Edit|EditNotebook"
      },
      {
        "command": "node .cursor/hooks/prose-positive-nudge.js",
        "matcher": "Write|StrReplace|MultiEdit|Edit|EditNotebook"
      }
    ]
  }
}
